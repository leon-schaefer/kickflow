# dependencies
node_modules/

# build output
dist/

# Vite
.vite/
node_modules/.vite/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.orig.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Vercel
.vercel

# probe.ts Rohdumps gegen den echten Account
scripts/.probe-output/

# typescript
*.tsbuildinfo

# written by scripts/write-build-id.ts before each web export
/public/build-id.txt

# Erzeugt von scripts/write-seo-files.ts vor jedem Web-Build — Inhalt haengt an
# der Umgebung (Domain, Production vs. Preview), nicht am Quelltext.
/public/robots.txt
/public/sitemap.xml
