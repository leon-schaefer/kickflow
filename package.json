{
  "name": "kickflow",
  "version": "1.0.2",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.16",
    "expo-observe": "~57.0.17",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.19",
    "react": "^19.2.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "tsx scripts/write-build-id.ts && expo export -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe.ts",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production",
    "update:promote": "eas update:republish --channel preview --destination-channel production",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest --auto-testflight-setup",
    "release:ios": "eas build --platform ios --profile production --auto-submit"
  },
  "private": true
}
