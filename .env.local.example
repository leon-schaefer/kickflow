# Kopieren nach .env.local (wird von git ignoriert) und ausfüllen.

# Nur für scripts/probe.ts — landet nie im App-Code oder im Build.
KICKBASE_EMAIL=
KICKBASE_PASSWORD=

# Ziel des Unterstützen-Buttons im Mehr-Tab (Ko-fi, Buy Me a Coffee, PayPal.me …).
# Muss mit https:// beginnen, sonst wird der Wert verworfen.
# Nicht gesetzt = die Unterstützen-Karte erscheint gar nicht.
#
# Achtung: EXPO_PUBLIC_* wird beim Bundling in den Client eingebacken und ist
# damit öffentlich. Hier gehört nur eine URL rein, die ohnehin jeder sehen soll.
#
# Für Deploys in den Vercel-Projekt-Env-Vars setzen.
EXPO_PUBLIC_SUPPORT_URL=

# Herkunft für die Open-Graph-Tags (Vorschaukarte geteilter Links), z.B.
# https://kickflow.example. Optional: ohne den Wert nimmt der Build
# VERCEL_PROJECT_PRODUCTION_URL, das Vercel selbst setzt. Gebraucht erst,
# wenn die App unter einer anderen Domain läuft. Lokal ohne Belang — dort
# fällt der Build auf http://localhost:4173 zurück (scripts/siteOrigin.ts).
VITE_SITE_URL=
